# Drizzle
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Attachment storage
# Local filesystem path where uploaded files are stored — in Docker this should point at a
# mounted volume (e.g. /data/uploads) so uploads survive container recreation.
UPLOADS_DIR="./uploads"

# SMTP (optional) — password resets, invites, and notifications print to the console instead of
# sending when SMTP_HOST is unset.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# Node adapter (adapter-node) server settings — only relevant when running `node build`, e.g. in
# Docker; ignored by `npm run dev`.
# PORT="3000"
# HOST="0.0.0.0"
