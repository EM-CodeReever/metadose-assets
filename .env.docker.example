# Copy to .env before running `docker compose up` — this is read by docker-compose.yml itself,
# separate from the app's own .env.example (used for `npm run dev` outside Docker).

# MySQL container
MYSQL_ROOT_PASSWORD="change-me"
MYSQL_DATABASE="metadose_assets"

# Better Auth — for production use 32+ characters, generated with high entropy.
BETTER_AUTH_SECRET=""

# Public URL the app is reachable at (used for cookies, email links, CSRF origin checks).
ORIGIN="http://localhost:3000"

# Host port the app is published on (container always listens on 3000 internally).
APP_PORT="3000"

# SMTP (optional) — password resets/invites print to the container's logs instead of sending
# when this is left blank.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
